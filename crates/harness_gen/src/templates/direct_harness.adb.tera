--  generated_harnesses/{{ harness_id }}/main.adb
--  SPDX-License-Identifier: Apache-2.0
pragma Ada_2012;
with Ada.Streams; use Ada.Streams;
with Ada.Exceptions;
with Interfaces; use Interfaces;
with AdaFuzz.Input;
with AdaFuzz.Decode;
with AdaFuzz.Probe;
{%- if needs_unchecked_dealloc %}
with Ada.Unchecked_Deallocation;
{%- endif %}
{%- if needs_stream_sink %}
with Gf_Sink_Streams;
{%- endif %}
{%- if needs_source_stream %}
with Gf_Source_Streams;
{%- endif %}
{%- if needs_callbacks %}
with Gf_Callbacks;
{%- endif %}
{%- for w in target_unit_withs %}
with {{ w }};
{%- endfor %}
{%- for u in use_units %}
use {{ u }};
{%- endfor %}

procedure {{ harness_unit }} is
   use type Interfaces.Unsigned_64;

   Buf  : aliased Stream_Element_Array := (1 .. 1 * 1024 * 1024 => 0);
   Last : Stream_Element_Offset;
   TC   : AdaFuzz.Probe.Testcase_Id := 0;
{%- for p in params %}
{%- if p.once_decl %}
   {{ p.once_decl }}
{%- endif %}
{%- endfor %}
begin
   loop
      AdaFuzz.Input.Load_From_Stdin (Buf, Last);
      exit when Last < Buf'First;
      TC := TC + 1;
      AdaFuzz.Probe.Begin_Testcase (TC);
      AdaFuzz.Probe.Set_Target ({{ harness_target_id_hex }});
      begin
      declare
         Cur : AdaFuzz.Decode.Cursor := AdaFuzz.Decode.Open (Buf'Unchecked_Access, Last);
{%- for line in generic_stub_decls %}
         {{ line }}
{%- endfor %}
{%- if generic_instantiation %}
         {{ generic_instantiation }}
{%- endif %}
{%- for p in params %}
{%- for line in p.setup_lines %}
         {{ line }}
{%- endfor %}
{%- endfor %}
{%- for p in params %}
{%- if p.once_decl %}
{#- declared once at procedure level (a bounded output sink); not re-declared per input #}
{%- elif p.needs_initializer %}
         {{ p.name }} : {{ p.ada_type_name }} := {{ p.decoder_expr }};
{%- else %}
         {{ p.name }} : {{ p.ada_type_name }};
{%- endif %}
{%- endfor %}
      begin
{%- for p in params %}
{%- for line in p.pre_call_lines %}
         {{ line }}
{%- endfor %}
{%- endfor %}
{%- if return_type_present %}
         declare
            Gf_Result : constant {{ return_type_ada_name }} := {{ qualified_target_name }}{% if params | length > 0 %} ({% for p in params %}{{ p.name }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %};
            pragma Unreferenced (Gf_Result);
         begin
            null;
         end;
{%- else %}
         {{ qualified_target_name }}{% if params | length > 0 %} ({% for p in params %}{{ p.name }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %};
{%- endif %}
{%- for p in params %}
{%- for line in p.post_call_lines %}
         {{ line }}
{%- endfor %}
{%- endfor %}
      exception
{%- if needs_callbacks %}
         when Gf_Callbacks.GF_Fuzz_EOF =>
            --  A source callback ran out of fuzz input: the normal end of this
            --  testcase, not a finding. Skip it silently.
            null;
{%- endif %}
         when AdaFuzz_E : others =>
            AdaFuzz.Probe.On_Top_Level_Catch
              (Ada.Exceptions.Exception_Name (AdaFuzz_E),
               Ada.Exceptions.Exception_Message (AdaFuzz_E));
      end;
      exception
         when others =>
            --  A parameter initializer raised in the declarative part (e.g. a
            --  decoder draw outside the parameter's subtype range), which the
            --  inner handler above cannot catch. Skip this input rather than
            --  let the exception escape and crash the harness process.
            null;
      end;
      AdaFuzz.Probe.End_Testcase;
      AdaFuzz.Probe.Flush;
   end loop;
{%- for f in sink_frees %}
   {{ f }}
{%- endfor %}
end {{ harness_unit }};
