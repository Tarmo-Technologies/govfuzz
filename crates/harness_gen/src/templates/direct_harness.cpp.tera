    // `-fno-exceptions`) would otherwise fail with "cannot use 'try' with
    // exceptions disabled"; there the body simply runs unguarded.
#if defined(__cpp_exceptions) || defined(__EXCEPTIONS)
    try {
#endif
    gf_cursor Cur = gf_open(Data, Size);
{%- for p in params %}
    {{ p.decl }};
{%- endfor %}
{%- if factory %}
    // Factory-based receiver: the owner is stack-allocated and kept in scope so
    // the receiver's lifetime (which may be owned by the factory's owner) is safe.
{%- for p in factory.params %}
    {{ p.decl }};
{%- endfor %}
{%- if factory.owner_type and factory.owner_method_is_static %}
    auto _gf_receiver = {{ factory.owner_type }}::{{ factory.method }}({% for p in factory.params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- elif factory.owner_type %}
    {{ factory.owner_type }} _gf_owner;
    auto _gf_receiver = _gf_owner.{{ factory.method }}({% for p in factory.params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- else %}
    auto _gf_receiver = {{ factory.method }}({% for p in factory.params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- endif %}
{%- if factory.receiver_is_pointer %}
{%- if return_type_present %}
    {{ return_type }} R{};
{%- endif %}
    if (_gf_receiver) {
        GOVFUZZ_TARGET_ENTER();
{%- if return_type_present %}
        R = _gf_receiver->{{ target_name }}({% for p in params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- else %}
        (void)_gf_receiver->{{ target_name }}({% for p in params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- endif %}
    }
{%- else %}
    GOVFUZZ_TARGET_ENTER();
    {% if return_type_present %}{{ return_type }} R = {% endif %}_gf_receiver.{{ target_name }}({% for p in params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- endif %}
{%- elif receiver_class %}
