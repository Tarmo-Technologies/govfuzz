#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
// Defensive C++ standard-library prelude (campaign: cpptoml). Header-only
// libraries routinely use std::numeric_limits / std::size_t / std::string while
// relying on a transitive standard include a normal consumer happens to have
// pulled in first (e.g. cpptoml.h reaches for std::numeric_limits<long> at file
// scope without its own <limits>). Emitting these cheap, header-only,
// always-available standard headers BEFORE the target/library headers lets such
// a header compile in our minimal translation unit. Order matters: stdlib
// prelude first, then the govfuzz decode runtime, then the target headers.
#include <limits>
#include <cstdint>
#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <stdio.h>
#include <string>
#include <string_view>
#include <vector>
#include <memory>
#include <utility>
{%- if uses_array %}
#include <array>
{%- endif %}
{%- if uses_bitset %}
#include <bitset>
{%- endif %}
{%- if uses_chrono %}
#include <chrono>
{%- endif %}
{%- if uses_deque %}
#include <deque>
{%- endif %}
{%- if uses_filesystem %}
#include <filesystem>
{%- endif %}
{%- if uses_forward_list %}
#include <forward_list>
{%- endif %}
{%- if uses_functional %}
#include <functional>
{%- endif %}
{%- if uses_list %}
#include <list>
{%- endif %}
{%- if uses_map %}
#include <map>
{%- endif %}
{%- if uses_optional %}
#include <optional>
{%- endif %}
{%- if uses_set %}
#include <set>
{%- endif %}
{%- if uses_span %}
#include <span>
{%- endif %}
{%- if uses_tuple %}
#include <tuple>
{%- endif %}
{%- if uses_unordered_map %}
#include <unordered_map>
{%- endif %}
{%- if uses_unordered_set %}
#include <unordered_set>
{%- endif %}
{%- if uses_variant %}
#include <variant>
{%- endif %}
#include "govfuzz_decode.h"
{%- for header in target_includes %}
#include "{{ header }}"
{%- endfor %}

// Keep target-header libc redirects out of the generated coverage/runtime
// driver. For example, c-ares maps getenv to its restricted ares_getenv.
#ifdef getenv
#undef getenv
#endif

// Sanitizer-runtime callbacks (edge coverage + cmplog operand capture, #400)
// must never be instrumented themselves: with `-fsanitize-coverage=trace-cmp`
// on, an un-attributed compare inside one of these would recurse into the
// trace-cmp callback and tank throughput on every edge. Mark them all NOCOV.
#ifndef GOVFUZZ_NOCOV
#if defined(__has_attribute)
#if defined(__clang__) && __has_attribute(no_sanitize)
#define GOVFUZZ_NOCOV __attribute__((no_sanitize("coverage")))
#elif __has_attribute(no_sanitize_coverage)
#define GOVFUZZ_NOCOV __attribute__((no_sanitize_coverage))
#elif __has_attribute(no_sanitize)
#define GOVFUZZ_NOCOV __attribute__((no_sanitize("coverage")))
#endif
#endif
#endif
#ifndef GOVFUZZ_NOCOV
#define GOVFUZZ_NOCOV
#endif

// Keep a value-returning target call observable even when its result is not
// otherwise consumed. Source-local/header-only targets are visible to the
// optimizer; a plain `(void)R` lets it delete a pure parser call entirely.
#if defined(__GNUC__) || defined(__clang__)
#define GOVFUZZ_KEEP_RESULT(value) \
    __asm__ __volatile__("" : : "g"(std::addressof(value)) : "memory")
#else
#define GOVFUZZ_KEEP_RESULT(value) ((void)(value))
#endif

{%- for ns in using_namespaces %}
using namespace {{ ns }};
{%- endfor %}

{# Emit a forward declaration for a free function (class members can't be
   forward-declared outside the class body). Normally an included project header
   already brings the function into scope, so we skip the decl when one is
   present. EXCEPTION: a namespace-qualified free function still gets the decl
   even with a header, because the auto-included header (e.g. a precompiled
   `StdAfx.h`) frequently does NOT declare this particular symbol — without the
   decl the qualified call is an `undeclared identifier`. A namespace-scoped
   redeclaration matching the real one is legal C++. #}
{%- if not passthrough_libfuzzer_entrypoint and not target_is_method and (not has_target_header or forward_namespace) %}
{% if forward_namespace %}namespace {{ forward_namespace }} {
{% endif %}{{ forward_return_type }} {{ target_name }}({% for type in forward_param_types %}{{ type }}{% if not loop.last %}, {% endif %}{% endfor %});
{% if forward_namespace %}}
{% endif %}
{%- endif %}

// #93: forward-declare govfuzz's own generated entry points before their
// definitions, so a recovered compile database's `-Wmissing-declarations`/
// `-Wmissing-prototypes` policy (often with `-Werror`), which govfuzz applies to
// this generated translation unit too, does not fail the harness build. The
// project's own sources still receive the full recovered warning policy.
extern "C" int govfuzz_run_one(const uint8_t *Data, size_t Size);
{%- if not passthrough_libfuzzer_entrypoint %}
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size);
{%- endif %}

// Auto-injected by govfuzz: republish fuzz input to the Linux runtrace shim so
// fuzz-driven mode can route the current iteration's bytes into fake fds /
// socket peers / dlopen stubs. Windows has no preload shim and must not emit a
// COFF weak reference: multiple weak defaults conflict under link.exe.
#if defined(_WIN32)
#define GOVFUZZ_PUBLISH_INPUT(data, size) ((void)0)
#else
extern "C" void govfuzz_shim_set_fuzz_input(const uint8_t *data, size_t size) __attribute__((weak));
#define GOVFUZZ_PUBLISH_INPUT(data, size) do { \
    if (govfuzz_shim_set_fuzz_input) govfuzz_shim_set_fuzz_input((data), (size)); \
} while (0)
#endif

// The external native driver records a one-byte proof immediately before the
// selected project endpoint. AFL/standalone builds currently have no shared
// marker runtime, so they report entry as unobserved rather than fabricating it.
#if defined(GOVFUZZ_EXTERNAL_DRIVER)
extern "C" void govfuzz_target_enter(void);
#define GOVFUZZ_TARGET_ENTER() govfuzz_target_enter()
#else
#define GOVFUZZ_TARGET_ENTER() ((void)0)
#endif

{%- if passthrough_libfuzzer_entrypoint %}
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size);
extern "C" int govfuzz_run_one(const uint8_t *Data, size_t Size) {
    GOVFUZZ_TARGET_ENTER();
    return LLVMFuzzerTestOneInput(Data, Size);
}
{% raw %}#ifndef GOVFUZZ_EXTERNAL_DRIVER
/* govfuzz driver for a passthrough libFuzzer entrypoint (C++).
 *
 * The project already supplies `LLVMFuzzerTestOneInput`. Rather than linking
 * libFuzzer's own `main` (`-fsanitize=fuzzer`) and then mis-driving it from the
 * built-in engine — which on C++ amalgamations fabricated empty-testcase findings
 * and yielded zero govfuzz coverage (#408, same family as the C-side #388) — we
 * provide a lightweight `main` with NO libFuzzer runtime, plus the SanitizerCoverage
 * edge-coverage + RedQueen/cmplog + value-profile runtime so the engine reports
 * real coverage (#385/#398/#400). The Makefile compiles this with
 * `-fsanitize-coverage=trace-pc-guard,trace-cmp` and WITHOUT `-fsanitize=fuzzer`.
 * The runtime is the C driver's, wrapped in extern "C" so the sanitizer resolves
 * the unmangled callback names; layout MUST stay in sync with direct_harness.c.tera
 * and CmpShmReader in crates/cli/src/fuzz.rs. */
#ifdef _WIN32
#define WIN32_LEAN_AND_MEAN
#ifndef NOMINMAX
#define NOMINMAX
#endif
#include <windows.h>
#include <io.h>
#include <fcntl.h>
#define GF_DEVNULL "NUL"
#define gf_read _read
#define gf_write _write
#define gf_dup _dup
#define gf_dup2 _dup2
#define gf_close _close
#define gf_open _open
#else
#include <unistd.h>
#include <fcntl.h>
#include <sys/mman.h>
#define GF_DEVNULL "/dev/null"
#define gf_read read
#define gf_write write
#define gf_dup dup
#define gf_dup2 dup2
#define gf_close close
#define gf_open open
#endif

/* Map a shared, file-backed region of `size` bytes at `path`, or 0 on failure.
 * POSIX: open+ftruncate+mmap(MAP_SHARED). Windows: CreateFileMapping +
 * MapViewOfFile, which writes through to the backing file so the engine reads the
 * same bytes (under wine the host sees the same file). */
GOVFUZZ_NOCOV static void *gf_map_shared(const char *path, size_t size) {
#ifdef _WIN32
    HANDLE fh = CreateFileA(path, GENERIC_READ | GENERIC_WRITE,
                            FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
                            OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    if (fh == INVALID_HANDLE_VALUE) return NULL;
    HANDLE mh = CreateFileMappingA(fh, NULL, PAGE_READWRITE,
                                   (DWORD)(((uint64_t)size) >> 32),
                                   (DWORD)(size & 0xffffffffu), NULL);
    CloseHandle(fh);
    if (!mh) return NULL;
    return MapViewOfFile(mh, FILE_MAP_ALL_ACCESS, 0, 0, size);
#else
    int fd = gf_open(path, O_RDWR | O_CREAT, 0600);
    if (fd < 0) return NULL;
    void *p = NULL;
    if (ftruncate(fd, (off_t)size) == 0) {
        void *m = mmap(0, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
        if (m != MAP_FAILED) p = m;
    }
    gf_close(fd);
    return p;
#endif
}

#ifdef _WIN32
/* No ASan on mingw: a vectored exception handler converts a fatal fault into an
 * immediate, distinctive exit so the engine detects a crash under wine instead
 * of the process hanging in wine's debugger dialog — govfuzz's ASan substitute. */
#define GOVFUZZ_WIN_CRASH_EXIT 0x39
GOVFUZZ_NOCOV static LONG CALLBACK govfuzz_win_veh(EXCEPTION_POINTERS *info) {
    DWORD code = info->ExceptionRecord->ExceptionCode;
    switch (code) {
    case EXCEPTION_ACCESS_VIOLATION:
    case EXCEPTION_STACK_OVERFLOW:
    case EXCEPTION_ILLEGAL_INSTRUCTION:
    case EXCEPTION_INT_DIVIDE_BY_ZERO:
    case EXCEPTION_ARRAY_BOUNDS_EXCEEDED:
    case EXCEPTION_DATATYPE_MISALIGNMENT:
        fprintf(stderr, "GOVFUZZ_CRASH code=0x%lx\n", (unsigned long)code);
        fflush(stderr);
        TerminateProcess(GetCurrentProcess(), GOVFUZZ_WIN_CRASH_EXIT);
        return EXCEPTION_CONTINUE_SEARCH;
    default:
        return EXCEPTION_CONTINUE_SEARCH;
    }
}
GOVFUZZ_NOCOV static void govfuzz_win_install_crash_handler(void) {
    AddVectoredExceptionHandler(1, govfuzz_win_veh);
}
#endif

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size);
extern "C" int LLVMFuzzerInitialize(int *argc, char ***argv) __attribute__((weak));

#if !defined(GOVFUZZ_AFL)
extern "C" {
/* Edge-coverage runtime: trace-pc-guard sets one bit per instrumented edge in a
 * MAP_SHARED bitmap named by GOVFUZZ_COV_SHM, so coverage accumulates across all
 * per-spawn children (and within a persistent process) and the parent reads the
 * popcount. A no-op when GOVFUZZ_COV_SHM is unset. */
#define GOVFUZZ_COV_BITS (1u << 16)
static unsigned char *govfuzz_cov_map = 0;
static uint32_t govfuzz_cov_next = 0;
GOVFUZZ_NOCOV static void govfuzz_cov_open(void) {
    const char *p = getenv("GOVFUZZ_COV_SHM");
    if (!p || !*p) return;
    void *m = gf_map_shared(p, GOVFUZZ_COV_BITS);
    if (m) govfuzz_cov_map = (unsigned char *)m;
}
/* AFL-style hit-count buckets (#420): a SECOND MAP_SHARED byte-map named by
 * GOVFUZZ_COV_CNT_SHM, the SAME GOVFUZZ_COV_BITS size as the edge bitmap (one
 * byte per edge). trace-pc-guard saturating-increments this edge's per-exec hit
 * count IN ADDITION TO the unchanged presence bit; the engine zeroes it before
 * every exec and buckets the per-exec count, so a loop run N+1 vs N registers as
 * new coverage across an AFL bucket boundary that edge-presence cannot see. A
 * no-op when GOVFUZZ_COV_CNT_SHM is unset. Layout (size + per-edge byte) MUST
 * stay in sync with direct_harness.c.tera and the CoverageTracker count reader
 * in crates/cli/src/fuzz.rs. */
static unsigned char *govfuzz_cov_cnt_map = 0;
GOVFUZZ_NOCOV static void govfuzz_cov_cnt_open(void) {
    const char *p = getenv("GOVFUZZ_COV_CNT_SHM");
    if (!p || !*p) return;
    void *m = gf_map_shared(p, GOVFUZZ_COV_BITS);
    if (m) govfuzz_cov_cnt_map = (unsigned char *)m;
}
/* laf-intel comparison-progress (#421): a THIRD MAP_SHARED byte-map named by
 * GOVFUZZ_CMP_PROGRESS_SHM, one byte per hashed compare SITE. For every compare
 * the trace-cmp callbacks already see, the driver records this exec's MAX number
 * of matching LEADING bytes (1..7) at that site, so the engine can reward an
 * input that gets one more byte of a multi-byte gate correct — laf-intel's
 * gradient WITHOUT a clang split pass. The engine zeroes it before every exec and
 * folds a newly-reached leading-match LEVEL into a virgin map exactly like the
 * #420 hit-count buckets. A no-op when GOVFUZZ_CMP_PROGRESS_SHM is unset (flag
 * off / Ada / legacy). Layout (size + per-site byte) MUST stay in sync with the
 * other direct_harness template and the CoverageTracker progress reader in
 * crates/cli/src/fuzz.rs. */
#define GOVFUZZ_CMPP_BITS (1u << 16)
static unsigned char *govfuzz_cmpp_map = 0;
GOVFUZZ_NOCOV static void govfuzz_cmpp_open(void) {
    const char *p = getenv("GOVFUZZ_CMP_PROGRESS_SHM");
    if (!p || !*p) return;
    void *m = gf_map_shared(p, GOVFUZZ_CMPP_BITS);
    if (m) govfuzz_cmpp_map = (unsigned char *)m;
}
/* Hash a compare site (the return address captured in the trace-cmp callback)
 * relative to an in-module reference so the key is ASLR-INVARIANT across the
 * fork-server and per-spawn processes of one run. */
GOVFUZZ_NOCOV static unsigned govfuzz_cmpp_slot(const void *ra) {
    uintptr_t rel = (uintptr_t)ra - (uintptr_t)&govfuzz_cmpp_open;
    return (unsigned)(rel * 2654435761u) & (GOVFUZZ_CMPP_BITS - 1);
}
/* Record an integer compare's leading-byte match (#421). `a == b` is a full match
 * (the gate passes — real edges cover it) and carries no gradient, so it is
 * skipped; otherwise count the contiguous matching LOW bytes and MAX-raise it. */
GOVFUZZ_NOCOV static void govfuzz_cmpp_int(uint64_t a, uint64_t b, unsigned width, const void *ra) {
    unsigned m, i, slot;
    unsigned char p;
    if (!govfuzz_cmpp_map || a == b) return;
    if (width > 8) width = 8;
    m = 0;
    for (i = 0; i < width; i++) {
        if (((a >> (8 * i)) & 0xff) == ((b >> (8 * i)) & 0xff)) m++;
        else break;
    }
    if (m == 0) return;
    p = (unsigned char)(m > 7 ? 7 : m);
    slot = govfuzz_cmpp_slot(ra);
    if (govfuzz_cmpp_map[slot] < p) govfuzz_cmpp_map[slot] = p;
}
/* Record a buffer/string compare's common-prefix length (#421). `result == 0` is
 * a full match (gate passes) -> skipped; otherwise the number of equal leading
 * bytes is the gradient. `pc` is the real call site supplied by the ASan hook. */
GOVFUZZ_NOCOV static void govfuzz_cmpp_buf(const unsigned char *s1, const unsigned char *s2,
                                        unsigned n, int result, const void *pc) {
    unsigned m = 0, slot;
    unsigned char p;
    if (!govfuzz_cmpp_map || result == 0) return;
    if (n > 8u) n = 8u; /* leading-match LEVEL saturates at 7; scan no further */
    while (m < n && s1[m] == s2[m]) m++;
    if (m == 0) return;
    p = (unsigned char)(m > 7 ? 7 : m);
    slot = govfuzz_cmpp_slot(pc);
    if (govfuzz_cmpp_map[slot] < p) govfuzz_cmpp_map[slot] = p;
}

/* RedQueen/cmplog operand capture (#400). A per-exec ring of (operand_a,
 * operand_b) comparison pairs in a MAP_SHARED region named by GOVFUZZ_CMP_SHM.
 * Layout MUST stay in sync with CmpShmReader in crates/cli/src/fuzz.rs:
 *   [u32 armed][u32 count] then GOVFUZZ_CMP_CAP records of
 *   [u8 len_a][u8 len_b][u8 a[GOVFUZZ_CMP_OPMAX]][u8 b[GOVFUZZ_CMP_OPMAX]].
 * No-op when GOVFUZZ_CMP_SHM is unset. */
#define GOVFUZZ_CMP_CAP 2048u
#define GOVFUZZ_CMP_OPMAX 32u
#define GOVFUZZ_CMP_REC (2u + 2u * GOVFUZZ_CMP_OPMAX)
#define GOVFUZZ_CMP_BYTES (8u + GOVFUZZ_CMP_CAP * GOVFUZZ_CMP_REC)
static unsigned char *govfuzz_cmp_map = 0;
GOVFUZZ_NOCOV static void govfuzz_cmp_open(void) {
    const char *p;
    if (govfuzz_cmp_map) return;
    p = getenv("GOVFUZZ_CMP_SHM");
    if (!p || !*p) return;
    void *m = gf_map_shared(p, GOVFUZZ_CMP_BYTES);
    if (m) govfuzz_cmp_map = (unsigned char *)m;
}
GOVFUZZ_NOCOV static int govfuzz_cmp_armed(void) {
    unsigned char *m = govfuzz_cmp_map;
    if (!m) return 0;
    return m[0] | m[1] | m[2] | m[3];
}
GOVFUZZ_NOCOV static void govfuzz_cmp_push(const unsigned char *a, unsigned la,
                                           const unsigned char *b, unsigned lb) {
    unsigned char *m = govfuzz_cmp_map;
    unsigned count, off, i;
    if (!m) return;
    if (la > GOVFUZZ_CMP_OPMAX) la = GOVFUZZ_CMP_OPMAX;
    if (lb > GOVFUZZ_CMP_OPMAX) lb = GOVFUZZ_CMP_OPMAX;
    count = (unsigned)m[4] | ((unsigned)m[5] << 8) | ((unsigned)m[6] << 16) | ((unsigned)m[7] << 24);
    if (count >= GOVFUZZ_CMP_CAP) return;
    off = 8u + count * GOVFUZZ_CMP_REC;
    m[off] = (unsigned char)la;
    m[off + 1] = (unsigned char)lb;
    for (i = 0; i < la; i++) m[off + 2u + i] = a[i];
    for (i = 0; i < lb; i++) m[off + 2u + GOVFUZZ_CMP_OPMAX + i] = b[i];
    count++;
    m[4] = (unsigned char)count;
    m[5] = (unsigned char)(count >> 8);
    m[6] = (unsigned char)(count >> 16);
    m[7] = (unsigned char)(count >> 24);
}
GOVFUZZ_NOCOV static void govfuzz_cmp_int(uint64_t a, uint64_t b, unsigned width) {
    unsigned char ab[8], bb[8];
    unsigned i;
    if (!govfuzz_cmp_armed()) return;
    if (a == b || a == 0 || b == 0) return;
    if (width > 8) width = 8;
    for (i = 0; i < width; i++) {
        ab[i] = (unsigned char)(a >> (8 * i));
        bb[i] = (unsigned char)(b >> (8 * i));
    }
    govfuzz_cmp_push(ab, width, bb, width);
}
GOVFUZZ_NOCOV static unsigned govfuzz_cmp_copy(unsigned char *dst, const unsigned char *src,
                                               unsigned maxlen, int stop_at_nul) {
    unsigned i;
    for (i = 0; i < maxlen; i++) {
        unsigned char c = src[i];
        if (stop_at_nul && c == 0) break;
        dst[i] = c;
    }
    return i;
}
GOVFUZZ_NOCOV static void govfuzz_cmp_buf(const unsigned char *s1, const unsigned char *s2,
                                          unsigned n, int stop_at_nul, int result) {
    unsigned char a[GOVFUZZ_CMP_OPMAX], b[GOVFUZZ_CMP_OPMAX];
    unsigned la, lb;
    if (!govfuzz_cmp_armed() || result == 0) return; /* result==0: already equal, nothing to learn */
    if (n > GOVFUZZ_CMP_OPMAX) n = GOVFUZZ_CMP_OPMAX;
    la = govfuzz_cmp_copy(a, s1, n, stop_at_nul);
    lb = govfuzz_cmp_copy(b, s2, n, stop_at_nul);
    if (la == 0 && lb == 0) return;
    govfuzz_cmp_push(a, la, b, lb);
}

/* Value-profile runtime (#398). Captures each comparison's constant operand into
 * a MAP_SHARED token log at GOVFUZZ_VP_SHM that the engine folds into the mutator
 * dictionary. In-process dedup keeps the log small; a no-op when unset. */
#define GOVFUZZ_VP_BYTES (1u << 16)
static unsigned char *govfuzz_vp_map = 0;
static unsigned char govfuzz_vp_seen1[256];
static uint64_t govfuzz_vp_seenN[4096];
GOVFUZZ_NOCOV static void govfuzz_vp_open(void) {
    const char *p = getenv("GOVFUZZ_VP_SHM");
    if (!p || !*p) return;
    void *m = gf_map_shared(p, GOVFUZZ_VP_BYTES);
    if (m) govfuzz_vp_map = (unsigned char *)m;
}
GOVFUZZ_NOCOV static void govfuzz_vp_add(const unsigned char *data, unsigned len) {
    if (!govfuzz_vp_map || len == 0 || len > 8) return;
    /* Skip all-zero operands (ubiquitous, useless) and dedup. */
    unsigned z = 1;
    for (unsigned i = 0; i < len; i++) if (data[i]) { z = 0; break; }
    if (z) return;
    if (len == 1) {
        if (govfuzz_vp_seen1[data[0]]) return;
        govfuzz_vp_seen1[data[0]] = 1;
    } else {
        uint64_t h = 1469598103934665603ull;
        for (unsigned i = 0; i < len; i++) { h ^= data[i]; h *= 1099511628211ull; }
        h ^= len;
        uint64_t slot = h & 4095u;
        if (govfuzz_vp_seenN[slot] == h) return;
        govfuzz_vp_seenN[slot] = h;
    }
    uint32_t *cursor = (uint32_t *)govfuzz_vp_map;
    uint32_t c = *cursor;
    if ((size_t)c + 1u + len + 4u > GOVFUZZ_VP_BYTES) return;
    unsigned char *w = govfuzz_vp_map + 4 + c;
    w[0] = (unsigned char)len;
    for (unsigned i = 0; i < len; i++) w[1 + i] = data[i];
    *cursor = c + 1 + len;
}
GOVFUZZ_NOCOV void __sanitizer_cov_trace_pc_guard_init(uint32_t *start, uint32_t *stop) {
    if (start == stop || *start) return;
    for (uint32_t *x = start; x < stop; x++) *x = ++govfuzz_cov_next;
    govfuzz_cov_open();
    govfuzz_cov_cnt_open();
    govfuzz_cmp_open();
    govfuzz_cmpp_open();
}
GOVFUZZ_NOCOV void __sanitizer_cov_trace_pc_guard(uint32_t *guard) {
    if (!*guard || !govfuzz_cov_map) return;
    govfuzz_cov_map[*guard & (GOVFUZZ_COV_BITS - 1)] = 1;
    /* #420: in addition to the unchanged presence bit, saturating-increment this
     * edge's per-exec hit count so the engine can bucket loop/recursion depth. */
    if (govfuzz_cov_cnt_map && govfuzz_cov_cnt_map[*guard & (GOVFUZZ_COV_BITS - 1)] != 255)
        govfuzz_cov_cnt_map[*guard & (GOVFUZZ_COV_BITS - 1)]++;
}
/* Unified trace-cmp callbacks: feed BOTH the value-profile dictionary (#398) AND
 * the per-input RedQueen ring (#400). */
GOVFUZZ_NOCOV void __sanitizer_cov_trace_const_cmp1(uint8_t a, uint8_t b) { govfuzz_vp_add(&a, 1); govfuzz_vp_add(&b, 1); govfuzz_cmp_int(a, b, 1); govfuzz_cmpp_int(a, b, 1, __builtin_return_address(0)); }
#ifdef _WIN32
/* mingw-w64 gcc has no `trace-pc-guard`; the Windows build instruments with
 * `-fsanitize-coverage=trace-pc`, which calls this guard-less hook at each edge.
 * Hash the return address into the SAME bitmap the guard path fills so the
 * engine's coverage reader stays platform-agnostic. */
GOVFUZZ_NOCOV void __sanitizer_cov_trace_pc(void) {
    if (!govfuzz_cov_map) return;
    uintptr_t pc = (uintptr_t)__builtin_return_address(0);
    uint32_t h = ((uint32_t)(pc * 2654435761u) >> 4) & (GOVFUZZ_COV_BITS - 1);
    govfuzz_cov_map[h] = 1;
    if (govfuzz_cov_cnt_map && govfuzz_cov_cnt_map[h] != 255)
        govfuzz_cov_cnt_map[h]++;
}
#endif
