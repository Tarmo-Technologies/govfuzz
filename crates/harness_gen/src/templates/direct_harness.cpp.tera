    (void)_gf_receiver;
{%- else %}
{%- for p in constructor_params %}
    {{ p.decl }};
{%- endfor %}
    {{ receiver_class }} _gf_receiver{% if constructor_params %}({% for p in constructor_params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %};
{%- endif %}
{%- if lifecycle_steps %}
    size_t _gf_lifecycle_count = (size_t)(gf_u8(&Cur) % ({{ lifecycle_step_count }} + 1));
    for (size_t _gf_lifecycle_index = 0; _gf_lifecycle_index < _gf_lifecycle_count; ++_gf_lifecycle_index) {
        switch (gf_u8(&Cur) % {{ lifecycle_step_count }}) {
{%- for step in lifecycle_steps %}
        case {{ loop.index0 }}: {
{%- for p in step.params %}
            {{ p.decl }};
{%- endfor %}
            {% if step.return_type_present %}{{ step.return_type }} {{ step.result_name }} = {% endif %}_gf_receiver.{{ step.name }}({% for p in step.params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
{%- if step.return_type_present %}
