with "{{ ada_runtime_gpr_path }}";
{% for project in project_imports %}with "{{ project }}";
{% endfor %}

project {{ harness_id_underscore }} is

   for Source_Dirs use ({% for dir in source_dirs %}"{{ dir }}"{% if not loop.last %}, {% endif %}{% endfor %});
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa");
   end Compiler;

end {{ harness_id_underscore }};
