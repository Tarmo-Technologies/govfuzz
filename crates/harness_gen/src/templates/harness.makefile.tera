# SPDX-License-Identifier: Apache-2.0
# generated_harnesses/{{ harness_id }}/Makefile

.DEFAULT_GOAL := all

ifeq ($(origin CC), default)
CC = {{ c_compiler }}
endif
# Every govfuzz C direct harness (generated or passthrough) ships its own
# lightweight `main` — a persistent framed fork-server driver (#399/#398) — so we
# do NOT link libFuzzer's own `main` (the `fuzzer` sanitizer runtime); mixing the
# two crashed in driver glue (#388). `trace-pc-guard` feeds the harness's
# edge-coverage runtime (#385). `trace-cmp` feeds two consumers of comparison
# operands: the value-profile runtime that mines them into the dictionary (#398)
# and the RedQueen/cmplog capture that records operand pairs so the mutator can
# splice them at the offset they were compared (input-to-state, #400). ASan's
# str/mem-cmp interceptors call the harness's __sanitizer_weak_hook_* family for
# the same end. The engine drives it persistently.
# UBSan runs with abort_on_error=1:halt_on_error=1 under the engine, so a check
# that fires on legitimate-but-technically-UB code aborts on EVERY input and the
# target is reported as a runtime error with 0 executions instead of being
# fuzzed. We drop the three checks that fire on pervasive, harmless patterns —
# the set OSS-Fuzz also excludes: `function` (a typed callback called through a
# generic fn-pointer signature — every C stream/iterator/vtable interface, e.g.
# TinySoundFont), `vptr` (C++ vptr checks need RTTI, fire on legitimate
# downcasts), and `alignment` (binary parsers read `*(uint32_t*)p` at unaligned
# offsets). All high-signal checks (overflow, shift, OOB, null, return…) stay
# on. -fno-sanitize= must follow -fsanitize=undefined to subtract from the group.
# Legacy-C dialect ladder. EMPTY by default, so a normal build carries no -std
# at all and behaves exactly as it always has. The repair loop sets it (`make
# C_STD=gnu89`) when a modern default rejects pre-standard C, mirroring CXX_STD
# on the C++ side.
C_STD ?=
C_STD_FLAG := $(if $(C_STD),-std=$(C_STD),)

{% if compiler_is_gcc %}CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=alignment -fsanitize-coverage=trace-pc,trace-cmp
{% else %}CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=function,vptr,alignment -fsanitize-coverage=trace-pc-guard,trace-cmp
{% endif %}
# Isolate each function/data object so the linker can discard unrelated code in
# a legacy amalgamation or application TU. Otherwise an isolated target inherits
# undefined references from every unused function in the same source file.
SECTION_FLAGS ?= -ffunction-sections -fdata-sections
ifeq ($(shell uname -s),Darwin)
SECTION_LDFLAGS ?= -Wl,-dead_strip
else
SECTION_LDFLAGS ?= -Wl,--gc-sections
endif
# Auto writes this optional project-level fragment only after a modern linker
# proves that legacy tentative definitions need the pre-GCC-10 `-fcommon`
# behavior. Keeping it separate preserves modern defaults for ordinary C.
-include ../../c_compat.mk
C_COMPAT_FLAGS ?=
# AFL's compiler driver reserves the AFL_ env-var namespace, so the AFL
# build knobs use the AFLPP_ prefix to avoid colliding with it.
AFLPP_CC ?= afl-clang-fast
AFLPP_CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=function,vptr,alignment -DGOVFUZZ_AFL
# MemorySanitizer build: finds reads of UNINITIALIZED memory (CWE-457/908) — a
# whole bug class ASan/UBSan miss. MSan is mutually exclusive with ASan, so it is a
# separate binary that `auto` replays the ASan pass's corpus through (no new fuzz
# loop). track-origins reports where the uninitialized value came from.
MSAN_CC ?= clang
MSAN_CFLAGS ?= -O1 -g -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fsanitize-coverage=trace-pc-guard,trace-cmp
# ThreadSanitizer build: finds data races (CWE-362) — concurrent unsynchronized
# access to shared memory, a bug class ASan/UBSan miss. TSan is mutually exclusive
# with ASan, so it is a separate binary that `auto` replays the ASan pass's corpus
# through (no new fuzz loop). A race only surfaces when the target itself spawns
# threads while processing one input; single-threaded targets simply find none.
# Built at -O0: the replay binary is for race DETECTION, not speed, and higher
# optimization elides/reorders the unsynchronized stores TSan keys on (a write with
# no observed read is dead-store-eliminated), hiding real races.
TSAN_CC ?= clang
TSAN_CFLAGS ?= -O0 -g -fsanitize=thread -fsanitize-coverage=trace-pc-guard,trace-cmp
# Source-based coverage build: `auto` replays the fuzz corpus through it and reads
# per-line hit counts via llvm-cov to learn which lines the campaign EXECUTED — the
# positive evidence for negative fuzz-confirmation (a covered-but-survived static
# finding is a likely false positive) on the C/C++ lanes.
COV_CC ?= clang
COV_CFLAGS ?= -O0 -g -fprofile-instr-generate -fcoverage-mapping
# Differential build (two-compiler): a PORTABLE build (no clang-only coverage or
# UBSan-check subtraction) so the SAME source compiles under clang AND gcc, and
# `auto --differential A:B` can replay the corpus through both and flag inputs on
# which the two builds diverge in exit/crash behavior (GF-301). ASan stays on —
# it has identical semantics across clang/gcc — so a codegen-dependent memory bug
# that only one compiler's output triggers still surfaces as an exit divergence.
DIFF_CC ?= clang
DIFF_CFLAGS ?= -O2 -g -fsanitize=address
GOVFUZZ_DRIVER_SOURCE ?= {{ c_runtime_include }}/govfuzz_driver.c
GOVFUZZ_DRIVER_CFLAGS ?= -O1 -g
INCLUDES = -I . -I {{ c_runtime_include }}{% for inc in target_includes_dirs %} -iquote {{ inc }} -idirafter {{ inc }}{% endfor %}
BUILD_CONTEXT_PROVENANCE = {{ build_context_provenance }}
BUILD_CONTEXT_DROPPED = {{ build_context_dropped }}
COMPILE_DB_FLAGS = {% for flag in compile_flags %}{{ flag }}{% if not loop.last %} {% endif %}{% endfor %}
-include build_context_objects.mk
-include repair_context_objects.mk
CONTEXT_MAIN_OBJECTS ?=
CONTEXT_AFL_OBJECTS ?=
CONTEXT_MSAN_OBJECTS ?=
CONTEXT_TSAN_OBJECTS ?=
CONTEXT_COV_OBJECTS ?=
CONTEXT_DIFF_OBJECTS ?=
CONTEXT_PROV_OBJECTS ?=
REPAIR_CONTEXT_MAIN_OBJECTS ?=
REPAIR_CONTEXT_AFL_OBJECTS ?=
REPAIR_CONTEXT_MSAN_OBJECTS ?=
REPAIR_CONTEXT_TSAN_OBJECTS ?=
REPAIR_CONTEXT_COV_OBJECTS ?=
REPAIR_CONTEXT_DIFF_OBJECTS ?=
REPAIR_CONTEXT_PROV_OBJECTS ?=

ifdef GOVFUZZ_CONTEXT_PREPARE_FAILED
$(error $(GOVFUZZ_CONTEXT_PREPARE_FAILED))
endif

.PHONY: all afl msan tsan cov prov diff syntaxcheck clean
all: main

# Target sources stay OUT of the prerequisites and live only in the recipe: an
# absolute Windows source path carries a drive-letter colon (`C:\...`) which GNU
# make parses as a target:prereq separator ("multiple target patterns"). In the
# recipe the path is just an argument to the compiler, so the colon is harmless.
# (govfuzz regenerates the harness dir per attempt, so `main` is always built.)
govfuzz_driver.o: $(GOVFUZZ_DRIVER_SOURCE)
	$(CC) $(GOVFUZZ_DRIVER_CFLAGS) -c -o $@ $(GOVFUZZ_DRIVER_SOURCE)

main: main.c govfuzz_driver.o $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS)
	$(CC) $(CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS) $(AUTO_EXTRA_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

# Semantic check only: the same translation units under the same flags as
# `main`, minus code generation and the link. The repair loop reads compiler
# diagnostics, and a round that is going to fail has nothing to learn from the
# object code it would emit. Prebuilt objects are deliberately absent from both
# the prerequisites and the recipe: nothing is linked here, and passing an `.o`
# to `-fsyntax-only` is an error. Undefined symbols therefore cannot surface in
# this mode — they are found by the real build, which still runs before any
# target is called successful.
syntaxcheck: main.c
	$(CC) $(CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -fsyntax-only main.c{% for src in target_sources %} {{ src }}{% endfor %} $(AUTO_EXTRA_SOURCES)

afl: main_afl

main_afl: main.c $(CONTEXT_AFL_OBJECTS) $(REPAIR_CONTEXT_AFL_OBJECTS)
	$(AFLPP_CC) $(AFLPP_CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_AFL_OBJECTS) $(REPAIR_CONTEXT_AFL_OBJECTS) $(AUTO_EXTRA_SOURCES) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

msan: main_msan

main_msan: main.c govfuzz_driver.o $(CONTEXT_MSAN_OBJECTS) $(REPAIR_CONTEXT_MSAN_OBJECTS)
	$(MSAN_CC) $(MSAN_CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MSAN_OBJECTS) $(REPAIR_CONTEXT_MSAN_OBJECTS) $(AUTO_EXTRA_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

tsan: main_tsan

main_tsan: main.c govfuzz_driver.o $(CONTEXT_TSAN_OBJECTS) $(REPAIR_CONTEXT_TSAN_OBJECTS)
	$(TSAN_CC) $(TSAN_CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_TSAN_OBJECTS) $(REPAIR_CONTEXT_TSAN_OBJECTS) $(AUTO_EXTRA_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

cov: main_cov

main_cov: main.c govfuzz_driver.o $(CONTEXT_COV_OBJECTS) $(REPAIR_CONTEXT_COV_OBJECTS)
	$(COV_CC) $(COV_CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_COV_OBJECTS) $(REPAIR_CONTEXT_COV_OBJECTS) $(AUTO_EXTRA_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

diff: main_diff

main_diff: main.c govfuzz_driver.o $(CONTEXT_DIFF_OBJECTS) $(REPAIR_CONTEXT_DIFF_OBJECTS)
	$(DIFF_CC) $(DIFF_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_DIFF_OBJECTS) $(REPAIR_CONTEXT_DIFF_OBJECTS) $(AUTO_EXTRA_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

# Build-recovery provenance (stub-artifact vs real-defect): the SAME ASan build as
# `main`, but the injected stubs come from $(AUTO_PROV_SOURCES) — a poisoned copy in
# which every value-returning stub records its name and _Exit()s on call. Replaying a
# crash's min input through this binary tells `auto` whether the crash needed a
# fabricated stub value (a stub fired -> lab_only) or reproduced with none on its
# path (provably stub-independent -> confidence raised).
prov: main_prov

main_prov: main.c govfuzz_driver.o $(CONTEXT_PROV_OBJECTS) $(REPAIR_CONTEXT_PROV_OBJECTS)
	$(CC) $(CFLAGS) $(C_STD_FLAG) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) -DGOVFUZZ_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_PROV_OBJECTS) $(REPAIR_CONTEXT_PROV_OBJECTS) $(AUTO_PROV_SOURCES) govfuzz_driver.o $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS)

clean:
	rm -f main main_afl main_msan main_tsan main_cov main_prov main_diff govfuzz_driver.o
	rm -rf context_objs repair_context_objs
