    int _gf_derived_live = 0;
{%- endif %}
{%- for slot in thread_slots %}
    /* Result threading: an op's return value becomes an argument a later op can
     * take, so sequences like `id = add(x); remove(id); get(id)` are reachable.
     * The `_live` flag keeps an empty slot from being passed as if it held a
     * value the API had returned. */
