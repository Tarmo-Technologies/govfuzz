     * the SQL program, compile every statement, execute its VM, finalize it,
     * and advance through the tail before closing the in-memory database. */
    if (Size == SIZE_MAX) return 0;
    char *_gf_sql = (char *)malloc(Size + 1u);
    if (!_gf_sql) return 0;
    memcpy(_gf_sql, Data, Size);
    _gf_sql[Size] = '\0';
    sqlite3 *_gf_db = NULL;
    if (sqlite3_open(":memory:", &_gf_db) == SQLITE_OK) {
        const char *_gf_tail = _gf_sql;
        const char *_gf_end = _gf_sql + Size;
        for (size_t _gf_statement = 0;
             _gf_statement < 256u && _gf_tail < _gf_end && *_gf_tail;
             ++_gf_statement) {
            sqlite3_stmt *_gf_stmt = NULL;
            const char *_gf_next = NULL;
            size_t _gf_remaining = (size_t)(_gf_end - _gf_tail);
            int _gf_sql_bytes = _gf_remaining > (size_t)INT_MAX
                                    ? INT_MAX
