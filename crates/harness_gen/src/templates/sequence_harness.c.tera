{%- endif %}
{%- endfor %}
{%- endfor %}
{%- if object.end_step %}
{%- for p in object.end_step.params %}
{%- if p.decl %}
        {{ p.decl }};
{%- endif %}
{%- endfor %}
        {% if object.end_step.return_type_present %}{{ object.end_step.return_type }} {{ object.end_step.result_name }} = {% endif %}{{ object.end_step.name }}({{ object.end_step.receiver }}{% for p in object.end_step.params %}, {{ p.arg }}{% endfor %});
