            }
            if (!_gf_next || _gf_next <= _gf_tail || _gf_next > _gf_end) break;
            _gf_tail = _gf_next;
        }
        (void)sqlite3_close(_gf_db);
    } else if (_gf_db) {
        (void)sqlite3_close(_gf_db);
