{%- endif %}
{%- for p in end_step.params %}
{%- if p.free %}
        {{ p.free }};
{%- endif %}
{%- endfor %}
        _gf_derived_live = 0;
    }
{%- endif %}
    /* Teardown is owed only for a handle that is still OPEN. A close-verb op in
     * the loop above may already have released it, and closing twice is a
     * double-free the harness would be committing itself. */
    if (_gf_handle_live) {
{%- for p in end_step.params %}
    {{ p.decl }};
{%- endfor %}
    {% if end_step.return_type_present %}{{ end_step.return_type }} {{ end_step.result_name }} = {% endif %}{{ end_step.name }}({% if handle_is_pointer_value %}_gf_handle{% else %}&_gf_handle{% endif %}{% for p in end_step.params %}, {{ p.arg }}{% endfor %});
{%- if end_step.return_type_present %}
    GOVFUZZ_KEEP_RESULT({{ end_step.result_name }});
