{%- endif %}
            {% if step.return_type_present %}{{ step.return_type }} {{ step.result_name }} = {% endif %}{{ step.name }}({{ step.receiver }}{% for p in step.params %}, {{ p.arg }}{% endfor %});
{%- if step.return_type_present %}
