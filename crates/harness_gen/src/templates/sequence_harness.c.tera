{#- Recovered project flags apply to this generated TU too. Projects such as
    libarchive use `-Wmissing-prototypes -Werror`; declare govfuzz's exported
    driver hooks before their definitions without weakening the project's warning
    policy. #}
int govfuzz_run_one(const uint8_t *Data, size_t Size);
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size);

/* Auto-injected by govfuzz: republish fuzz input to the Linux runtrace shim so
 * fuzz-driven mode can route the current iteration's bytes into fake fds /
 * socket peers / dlopen stubs. Windows has no preload shim and must not emit a
 * COFF weak reference: multiple weak defaults conflict under link.exe. */
#if defined(_WIN32)
#define GOVFUZZ_PUBLISH_INPUT(data, size) ((void)0)
#else
extern void govfuzz_shim_set_fuzz_input(const uint8_t *data, size_t size) __attribute__((weak));
#define GOVFUZZ_PUBLISH_INPUT(data, size) do { \
    if (govfuzz_shim_set_fuzz_input) govfuzz_shim_set_fuzz_input((data), (size)); \
} while (0)
#endif
#if defined(GOVFUZZ_EXTERNAL_DRIVER)
extern void govfuzz_target_enter(void);
#define GOVFUZZ_TARGET_ENTER() govfuzz_target_enter()
#else
#define GOVFUZZ_TARGET_ENTER() ((void)0)
#endif
int govfuzz_run_one(const uint8_t *Data, size_t Size) {
    GOVFUZZ_PUBLISH_INPUT(Data, Size);
{%- if expert_jpeg_decompress %}
    /* Public libjpeg decompressor lifecycle, matching maintained expert
     * harnesses. The decoder owns every internal controller; synthesizing
     * those private objects from fuzz bytes violates the API contract. */
    struct jpeg_decompress_struct _gf_cinfo;
    struct _gf_jpeg_error _gf_error;
    memset(&_gf_cinfo, 0, sizeof _gf_cinfo);
    memset(&_gf_error, 0, sizeof _gf_error);
    _gf_cinfo.err = jpeg_std_error(&_gf_error.pub);
    _gf_error.pub.error_exit = _gf_jpeg_error_exit;
    if (setjmp(_gf_error.jump)) {
        jpeg_destroy_decompress(&_gf_cinfo);
        return 0;
    }
    jpeg_create_decompress(&_gf_cinfo);
    jpeg_mem_src(&_gf_cinfo, Data, (unsigned long)Size);
    GOVFUZZ_TARGET_ENTER();
    int _gf_header = jpeg_read_header(&_gf_cinfo, TRUE);
    GOVFUZZ_KEEP_RESULT(_gf_header);
    if (_gf_header == JPEG_HEADER_OK && jpeg_start_decompress(&_gf_cinfo)) {
        size_t _gf_stride = (size_t)_gf_cinfo.output_width *
                            (size_t)_gf_cinfo.output_components;
        if (_gf_stride != 0 &&
            _gf_stride <= (size_t)((JDIMENSION)-1)) {
            JSAMPARRAY _gf_row = (*_gf_cinfo.mem->alloc_sarray)(
                (j_common_ptr)&_gf_cinfo, JPOOL_IMAGE,
                (JDIMENSION)_gf_stride, 1);
            /* Bound pathological dimensions so one decompression bomb cannot
             * monopolize a fuzz worker. Normal images drain completely. */
            size_t _gf_rows = 0;
            while (_gf_cinfo.output_scanline < _gf_cinfo.output_height &&
                   _gf_rows++ < 65536u) {
                if (jpeg_read_scanlines(&_gf_cinfo, _gf_row, 1) == 0) break;
            }
            if (_gf_cinfo.output_scanline >= _gf_cinfo.output_height) {
                (void)jpeg_finish_decompress(&_gf_cinfo);
            }
        }
    }
    jpeg_destroy_decompress(&_gf_cinfo);
{%- elif expert_sqlite_prepare %}
