    if (_gf_derived_live) {
{%- for p in end_step.params %}
        {{ p.decl }};
{%- endfor %}
        {% if end_step.return_type_present %}{{ end_step.return_type }} _gf_derived_end = {% endif %}{{ end_step.name }}(_gf_derived{% for p in end_step.params %}, {{ p.arg }}{% endfor %});
{%- if end_step.return_type_present %}
