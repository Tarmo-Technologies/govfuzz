    memset(&_gf_slot_{{ slot.slug }}, 0, sizeof _gf_slot_{{ slot.slug }});
    int _gf_slot_{{ slot.slug }}_live = 0;
{%- endfor %}
    for (size_t _gf_lifecycle_index = 0; _gf_lifecycle_index < _gf_lifecycle_count; ++_gf_lifecycle_index) {
        switch ((int)gf_ctrl_op(Data, Size, _gf_lifecycle_index, {{ op_max_steps }}, {{ op_steps | length }})) {
{%- for step in op_steps %}
        case {{ loop.index0 }}: {
{%- if step.receiver_selector %}
            int {{ step.receiver_selector }} = (int)gf_u8(&Cur);
