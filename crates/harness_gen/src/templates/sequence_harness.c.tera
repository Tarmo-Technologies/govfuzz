            _gf_handle_dead = 0;
{%- else %}
            _gf_handle_live = 1;
{%- endif %}
{%- endif %}
{%- for p in step.params %}
{%- if p.free %}
            {{ p.free }};
{%- endif %}
{%- endfor %}
            break;
        }
{%- endfor %}
        default:
            break;
        }
        if (_gf_handle_dead) {
            break;
        }
    }
{%- endif %}
{%- endif %}
{%- if end_step %}
{%- if derives_handle %}
    /* Release the derived object first. It is the same type as the handle, so
     * the handle's own teardown is its destructor — which is exactly the order
     * libexpat's fuzzer uses, freeing each child parser before the parent.
