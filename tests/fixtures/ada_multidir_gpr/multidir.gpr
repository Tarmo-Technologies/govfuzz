--  SPDX-License-Identifier: Apache-2.0
--  A multi-directory Ada library: the governing project enumerates two sibling
--  Source_Dirs. A target scanned in one (`src/parser`) depends on a unit in the
--  other (`src/core`); govfuzz must pull the sibling Source_Dir into the build.
project Multidir is
   for Languages use ("Ada");
   for Source_Dirs use ("src/core", "src/parser");
   for Object_Dir use "obj";
end Multidir;
